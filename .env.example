# Reference only — placeholders, not real values. Copy the variables you need into your actual
# shell environment or your IDE's Run/Debug Configuration -> Environment variables. This file is
# NOT automatically loaded by Spring Boot; it exists purely as documentation of what's required.
# Never fill this file in with real credentials and never commit a version that has them.

# Cloudflare R2 (Dashboard -> R2 -> Manage API tokens to create an access key pair)
R2_ENDPOINT=<your-r2-endpoint>                 # e.g. https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<your-access-key-id>
R2_SECRET_ACCESS_KEY=<your-secret-access-key>
R2_BUCKET=<your-bucket-name>
R2_REGION=auto                                 # R2's own convention; leave as "auto" unless you have a reason not to

# Optional — sensible defaults are used if omitted (see docs/storage.md)
STORAGE_MAX_FILE_SIZE_MB=4096                  # 4GB, to accommodate full-length compositions/stems
STORAGE_PRESIGNED_URL_EXPIRATION_MINUTES=15
