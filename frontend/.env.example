# Copy to .env.development (for `npm run dev`) or .env.production (for a production build).
# Never commit a version of these files with real values — .env/.env.production are gitignored;
# .env.example exists purely as documentation of what's required.

# Base URL of the Spring Boot API. No trailing slash.
VITE_API_BASE_URL=http://localhost:8080

# Google OAuth2 Web Client ID — the SAME value as google.oauth.client-id in the backend's
# application.properties (it's the audience the backend verifies ID tokens against, not a
# secret). Required for the "Sign in with Google" button; username/password login still works
# without it.
VITE_GOOGLE_CLIENT_ID=
